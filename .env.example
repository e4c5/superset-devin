# Copy to .env and fill in. NEVER commit the real .env.

# --- Devin API v3 -----------------------------------------------------------
# Service-user token (prefix cog_). The service user's role needs
# UseDevinSessions (create) and ViewOrgSessions (poll).
DEVIN_SERVICE_USER_TOKEN=cog_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEVIN_ORG_ID=org-d2a9a68f5bab400597bcc8c7e6e387a1
DEVIN_API_BASE=https://api.devin.ai

# --- GitHub -----------------------------------------------------------------
# Shared secret configured on the repo webhook; used for X-Hub-Signature-256.
GITHUB_WEBHOOK_SECRET=change-me-to-a-long-random-string
# PAT (or app token) with `repo` on TARGET_REPO: the orchestrator comments back
# on issues for dedup / error visibility and reads issue + PR state to decide
# whether a refiled finding may start a new session. Registering the webhook
# itself additionally needs repo admin (`admin:repo_hook`).
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_API_BASE=https://api.github.com

# --- Behaviour --------------------------------------------------------------
TARGET_REPO=e4c5/superset
TRIGGER_LABEL=devin-fix
# Per-session ACU cap. A session stopped by this cap is reported as
# blocked_on_budget, not as a failure.
MAX_ACU_LIMIT=10
# Base tick of the poll loop: how often the poller wakes up to look for records
# whose own gap has elapsed.
POLL_INTERVAL_SECONDS=30
# Per-session variable gap: a session that is still running is re-polled after
# min(BASE * 2**attempts, CAP) seconds, so a long session costs a handful of API
# calls instead of one every tick. The happy path does not wait for the gap: the
# `pull_request` webhook triggers an immediate check.
POLL_BACKOFF_BASE_SECONDS=30
POLL_BACKOFF_CAP_SECONDS=300
# Age-based backstop: a session with no terminal state after this long is
# resolved as timed_out regardless of the backoff schedule.
SESSION_MAX_WAIT_SECONDS=3600
# Settle a session as succeeded as soon as it has opened a pull request, and
# snapshot its ACUs at that moment, instead of waiting for the session to exit.
TERMINAL_ON_PR=true
# Run the full webhook path (signature, gate, parse, dedup, prompt build) and
# log the session it would have created instead of calling Devin. Needs only
# GITHUB_WEBHOOK_SECRET — useful for proving a tunnel/webhook setup at zero ACU.
DRY_RUN=false

# --- Local state ------------------------------------------------------------
DATABASE_PATH=data/state.db
REPORT_PATH=data/report.md
MAX_RETRIES=5
PORT=8080
# When set, /status and /report require `Authorization: Bearer <token>`. The
# localtunnel URL is public, so set this for anything beyond a local demo.
STATUS_TOKEN=
